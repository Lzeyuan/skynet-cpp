{
    "version": 3,
    "configurePresets": [
        {
            "name": "GCC 15.2.1 x86_64-redhat-linux",
            "hidden": true,
            "displayName": "GCC 15.2.1 x86_64-redhat-linux",
            "description": "Using compilers: C = /usr/lib64/ccache/gcc, CXX = /usr/lib64/ccache/g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/lib64/ccache/gcc",
                "CMAKE_CXX_COMPILER": "/usr/lib64/ccache/g++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            }
        },
        {
            "name": "GCC-15-ninja-debug",
            "displayName": "GCC-15-ninja-debug",
            "inherits": "GCC 15.2.1 x86_64-redhat-linux",
            "description": "Using compilers: C = /usr/lib64/ccache/gcc, CXX = /usr/lib64/ccache/g++",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
        ,
        {
            "name": "GCC-15-ninja-release",
            "displayName": "GCC-15-ninja-release",
            "inherits": "GCC 15.2.1 x86_64-redhat-linux",
            "description": "Using compilers: C = /usr/lib64/ccache/gcc, CXX = /usr/lib64/ccache/g++",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
